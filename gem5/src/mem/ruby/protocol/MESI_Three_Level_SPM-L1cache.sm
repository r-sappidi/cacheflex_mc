  action(g_issuePUTX, "g", desc="send data to the L2 cache") {
    enqueue(requestNetwork_out, RequestMsg, l1_response_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTX;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
      if (cache_entry.Dirty) {
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
        out_msg.DataBlk := cache_entry.DataBlk;
      } else {
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
    }
  }

  action(spm_bounceSilentGetS, "spbb", desc="Bounce a silent snapshot request back to the home: this L1 no longer holds the line") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS_SILENT;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        out_msg.MessageSize := MessageSizeType:Control;
      }
    }
  }

  action(spm_nackSilentGetS, "spnk", desc="NACK stale-owner forward on response channel") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := address;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:SPM_SILENT_RETRY;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(spm_rememberSilentRetry, "sprm", desc="Consume NACK without waiting for request FIFO space") {
    assert(spm_silent_retry);
    assert(is_valid(tbe));
    assert(!spmSilentRetryTimer.isSet(address));
    peek(responseNetwork_in, ResponseMsg) {
      assert(tbe.DstSPMAddr == in_msg.DstSPMAddr);
    }
    // No credit release/reallocation: this is still the same outstanding copy.
    spmSilentRetryTimer.set(address, clockEdge() + cyclesToTicks(spm_silent_retry_latency));
  }

  action(spm_reissueSilentGetS, "sprs", desc="Retry from bounded existing TBE; network input already released") {
    assert(is_valid(tbe));
    assert(spmSilentRetryTimer.isSet(address));
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      out_msg.addr := address;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Type := CoherenceRequestType:GETS_SILENT;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
      out_msg.MessageSize := MessageSizeType:Control;
      out_msg.AccessMode := tbe.SilentAccessMode;
    }
    spmSilentRetryTimer.unset(address);
  }

  action(spm_sendSilentDataToRequestor, "spsd", desc="send an SPM data snapshot to a silent requester without any coherence-state change") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := false;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        // No outstanding acks: the requester completes immediately and
        // installs the snapshot into its private SPM slot.
        out_msg.AckCount := 0;
      }
    }
  }

  action(spm_sendSilentDataToRequestor_fromTBE, "spsdt", desc="send an SPM data snapshot from a writeback TBE") {
    peek(requestNetwork_in, RequestMsg) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        assert(is_valid(tbe));
        out_msg.addr := address;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := false;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
      }
    }
  }

  action(j_sendUnblock, "j", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, to_l2_latency) {
