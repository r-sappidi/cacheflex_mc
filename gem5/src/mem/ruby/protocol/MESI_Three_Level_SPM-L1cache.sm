      out_msg.Class := CoherenceClass:FLUSH_DATA;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
    }
  }

  action(h_data_to_l0, "h", desc="If not prefetch, send data to the L0 cache.") {
      enqueue(bufferToL0_out, CoherenceMsg, l1_response_latency) {
          assert(is_valid(cache_entry));

          out_msg.addr := address;
          out_msg.Class := CoherenceClass:DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.MessageSize := MessageSizeType:Response_Data;
      }

      cache.setMRU(address);
  }

  action(hh_xdata_to_l0, "\h", desc="If not prefetch, notify sequencer that store completed.") {
      enqueue(bufferToL0_out, CoherenceMsg, l1_response_latency) {
          assert(is_valid(cache_entry));

          out_msg.addr := address;
          out_msg.Class := CoherenceClass:DATA_EXCLUSIVE;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;

          //cache_entry.Dirty := true;
      }

      cache.setMRU(address);
  }

  action(h_stale_data_to_l0, "hs", desc="If not prefetch, send data to the L0 cache.") {
      enqueue(bufferToL0_out, CoherenceMsg, l1_response_latency) {
          assert(is_valid(cache_entry));

          out_msg.addr := address;
          out_msg.Class := CoherenceClass:STALE_DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
       }
   }

  action(i_allocateTBE, "i", desc="Allocate TBE (number of invalidates=0)") {
    check_allocate(TBEs);
    assert(is_valid(cache_entry));
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.Dirty := cache_entry.Dirty;
    tbe.DataBlk := cache_entry.DataBlk;
  }

  action(spm_allocateTBE, "spat", desc="Allocate TBE for SPM fetch") {
    check_allocate(TBEs);
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    peek(messageBufferFromL0_in, CoherenceMsg) {
      tbe.SilentAccessMode := in_msg.AccessMode;
      tbe.SrcAddr := in_msg.SrcAddr;
      tbe.DstSPMAddr := in_msg.DstSPMAddr;
      tbe.SPMSet := in_msg.SPMSet;
      tbe.SPMWay := in_msg.SPMWay;
      tbe.Len := in_msg.Len;
      tbe.MulticastMask := in_msg.MulticastMask;
    }
  }

  action(spm_bufferL0Snapshot, "spb0", desc="Capture SPMCP payload without changing coherent source") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(tbe));
      assert(in_msg.SPMSnapshot);
      tbe.DataBlk := in_msg.DataBlk;
      tbe.Dirty := in_msg.Dirty;
    }
  }

  action(spm_bufferResponseData, "spbr", desc="Buffer response data for SPM install") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.DataBlk := in_msg.DataBlk;
    }
  }

  action(spm_sendMulticastPending, "spmp", desc="Announce pending multicast destination slots") {
    if (tbe.MulticastMask != 0) {
      enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
        out_msg.addr := tbe.DstSPMAddr;
        out_msg.SrcAddr := tbe.SrcAddr;
        out_msg.DstSPMAddr := tbe.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:SPM_MCAST_PENDING;
        out_msg.Sender := machineID;
        out_msg.MulticastMask := tbe.MulticastMask;
        if (bitSelect(intToAddress(tbe.MulticastMask), 0, 0) == intToAddress(1) && version != intToID(0)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(0))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 1, 1) == intToAddress(1) && version != intToID(1)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(1))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 2, 2) == intToAddress(1) && version != intToID(2)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(2))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 3, 3) == intToAddress(1) && version != intToID(3)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(3))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 4, 4) == intToAddress(1) && version != intToID(4)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(4))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 5, 5) == intToAddress(1) && version != intToID(5)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(5))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 6, 6) == intToAddress(1) && version != intToID(6)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(6))); }
        if (bitSelect(intToAddress(tbe.MulticastMask), 7, 7) == intToAddress(1) && version != intToID(7)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(7))); }
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(spm_bufferCacheData, "spbc", desc="Buffer resident source for multicast") {
    assert(is_valid(tbe));
    assert(is_valid(cache_entry));
    tbe.DataBlk := cache_entry.DataBlk;
    tbe.Dirty := cache_entry.Dirty;
  }

  action(spm_installFromTBE, "spit", desc="Install buffered data into SPM slot") {
    assert(is_valid(tbe));
    Entry spm_entry := static_cast(Entry, "pointer", cache[tbe.DstSPMAddr]);
    if (is_invalid(spm_entry)) {
      spm_entry := static_cast(Entry, "pointer",
          cache.allocateSPMSlot(tbe.DstSPMAddr, tbe.SPMSet, tbe.SPMWay,
                                new Entry));
    }
    spm_entry.CacheState := State:X;
    spm_entry.DataBlk := tbe.DataBlk;
    spm_entry.Dirty := false;
    spm_entry.setScratchpad(true);
    spm_entry.SrcAddr := tbe.SrcAddr;
    spm_entry.DstSPMAddr := tbe.DstSPMAddr;
    spm_entry.SPMSet := tbe.SPMSet;
    spm_entry.SPMWay := tbe.SPMWay;
    spm_entry.Len := tbe.Len;
  }

  action(spm_installFromCache, "spic", desc="Install resident source data into SPM slot") {
    assert(is_valid(tbe));
    assert(is_valid(cache_entry));
    Entry spm_entry := static_cast(Entry, "pointer", cache[tbe.DstSPMAddr]);
    if (is_invalid(spm_entry)) {
      spm_entry := static_cast(Entry, "pointer",
          cache.allocateSPMSlot(tbe.DstSPMAddr, tbe.SPMSet, tbe.SPMWay,
                                new Entry));
    }
    spm_entry.CacheState := State:X;
    spm_entry.DataBlk := cache_entry.DataBlk;
    spm_entry.Dirty := false;
    spm_entry.setScratchpad(true);
    spm_entry.SrcAddr := tbe.SrcAddr;
    spm_entry.DstSPMAddr := tbe.DstSPMAddr;
    spm_entry.SPMSet := tbe.SPMSet;
    spm_entry.SPMWay := tbe.SPMWay;
    spm_entry.Len := tbe.Len;
  }

  action(spm_claimSlot, "spcl", desc="Claim private-L1 SPM slot") {
    if (is_invalid(cache_entry)) {
      peek(messageBufferFromL0_in, CoherenceMsg) {
        set_cache_entry(cache.allocateSPMSlot(address, in_msg.SPMSet,
                                             in_msg.SPMWay, new Entry));
      }
    }
    assert(is_valid(cache_entry));
    peek(messageBufferFromL0_in, CoherenceMsg) {
      cache_entry.CacheState := State:X;
      cache_entry.DataBlk.clear();
      cache_entry.Dirty := false;
      cache_entry.setScratchpad(true);
      cache_entry.SrcAddr := in_msg.SrcAddr;
      cache_entry.DstSPMAddr := in_msg.DstSPMAddr;
      cache_entry.SPMSet := in_msg.SPMSet;
      cache_entry.SPMWay := in_msg.SPMWay;
      cache_entry.Len := in_msg.Len;
    }
  }

  action(spm_sendMulticastFromTBE, "spmt", desc="Multicast buffered SPM data to remote private L1s") {
    assert(is_valid(tbe));
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := tbe.DstSPMAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Type := CoherenceResponseType:SPM_MCAST_DATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := false;
      out_msg.Sender := machineID;
      out_msg.MulticastMask := tbe.MulticastMask;
      if (bitSelect(intToAddress(tbe.MulticastMask), 0, 0) == intToAddress(1) && version != intToID(0)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(0))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 1, 1) == intToAddress(1) && version != intToID(1)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(1))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 2, 2) == intToAddress(1) && version != intToID(2)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(2))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 3, 3) == intToAddress(1) && version != intToID(3)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(3))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 4, 4) == intToAddress(1) && version != intToID(4)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(4))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 5, 5) == intToAddress(1) && version != intToID(5)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(5))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 6, 6) == intToAddress(1) && version != intToID(6)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(6))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 7, 7) == intToAddress(1) && version != intToID(7)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(7))); }
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
  }

  action(spm_sendRetainedMulticast, "sprmc", desc="Multicast buffered SPM data to remote private L1s") {
    assert(is_valid(tbe));
    if (tbe.MulticastMask != 0) {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := tbe.DstSPMAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Type := CoherenceResponseType:SPM_MCAST_DATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := false;
      out_msg.Sender := machineID;
      out_msg.MulticastMask := tbe.MulticastMask;
      if (bitSelect(intToAddress(tbe.MulticastMask), 0, 0) == intToAddress(1) && version != intToID(0)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(0))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 1, 1) == intToAddress(1) && version != intToID(1)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(1))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 2, 2) == intToAddress(1) && version != intToID(2)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(2))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 3, 3) == intToAddress(1) && version != intToID(3)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(3))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 4, 4) == intToAddress(1) && version != intToID(4)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(4))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 5, 5) == intToAddress(1) && version != intToID(5)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(5))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 6, 6) == intToAddress(1) && version != intToID(6)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(6))); }
      if (bitSelect(intToAddress(tbe.MulticastMask), 7, 7) == intToAddress(1) && version != intToID(7)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(7))); }
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    }
  }

  action(spm_sendMulticastClaim, "spmc", desc="Ask remote private L1s to reserve this SPM slot") {
    assert(is_valid(tbe));
    tbe.pendingAcks := 0;
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      out_msg.addr := tbe.DstSPMAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Type := CoherenceResponseType:SPM_MCAST_CLAIM;
      out_msg.Sender := machineID;
      out_msg.MulticastMask := tbe.MulticastMask;
      if (bitSelect(intToAddress(tbe.MulticastMask), 0, 0) == intToAddress(1) && version != intToID(0)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(0))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 1, 1) == intToAddress(1) && version != intToID(1)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(1))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 2, 2) == intToAddress(1) && version != intToID(2)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(2))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 3, 3) == intToAddress(1) && version != intToID(3)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(3))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 4, 4) == intToAddress(1) && version != intToID(4)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(4))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 5, 5) == intToAddress(1) && version != intToID(5)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(5))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 6, 6) == intToAddress(1) && version != intToID(6)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(6))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      if (bitSelect(intToAddress(tbe.MulticastMask), 7, 7) == intToAddress(1) && version != intToID(7)) { out_msg.Destination.add(createMachineID(MachineType:L1Cache, intToID(7))); tbe.pendingAcks := tbe.pendingAcks + 1; }
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
    assert(tbe.pendingAcks > 0);
  }

  action(spm_installMulticastClaim, "spmci", desc="Reserve a remotely claimed SPM slot") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry spm_entry := static_cast(Entry, "pointer", cache[in_msg.DstSPMAddr]);
      int spm_set := addressToInt(bitSelect(in_msg.DstSPMAddr, 6, 15));
      int spm_way := addressToInt(bitSelect(in_msg.DstSPMAddr, 16, 18));
      if (is_invalid(spm_entry)) {
        spm_entry := static_cast(Entry, "pointer",
            cache.allocateSPMSlot(in_msg.DstSPMAddr, spm_set, spm_way,
                                  new Entry));
      }
      spm_entry.CacheState := State:X;
      spm_entry.DataBlk.clear();
      spm_entry.Dirty := false;
      spm_entry.setScratchpad(true);
      spm_entry.SrcAddr := in_msg.SrcAddr;
      spm_entry.DstSPMAddr := in_msg.DstSPMAddr;
      spm_entry.SPMSet := spm_set;
      spm_entry.SPMWay := spm_way;
      spm_entry.Len := 64;
    }
  }

  action(spm_sendMulticastClaimAck, "spmca", desc="Acknowledge a remote SPM slot claim") {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      peek(responseNetwork_in, ResponseMsg) {
        out_msg.addr := in_msg.DstSPMAddr;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:SPM_MCAST_CLAIM_ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Sender);
        out_msg.AckCount := 1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(spm_claimAckToL0, "spmcal", desc="Complete a multicast way claim at its issuing L0") {
    spmZeroData.clear();
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_response_latency) {
      assert(is_valid(tbe));
      // Claim-only SPMCPs use the canonical destination slot as their
      // Sequencer transaction key because they perform no coherent fetch.
      out_msg.addr := tbe.DstSPMAddr;
      out_msg.Class := CoherenceClass:SPM_ACK;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := spmZeroData;
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(spm_installMulticastData, "spmi", desc="Install multicast data in this private SPM") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry spm_entry := static_cast(Entry, "pointer", cache[in_msg.DstSPMAddr]);
      int spm_set := addressToInt(bitSelect(in_msg.DstSPMAddr, 6, 15));
      int spm_way := addressToInt(bitSelect(in_msg.DstSPMAddr, 16, 18));
      if (is_invalid(spm_entry)) {
        spm_entry := static_cast(Entry, "pointer",
            cache.allocateSPMSlot(in_msg.DstSPMAddr, spm_set, spm_way,
                                  new Entry));
      }
      spm_entry.CacheState := State:X;
      spm_entry.DataBlk := in_msg.DataBlk;
      spm_entry.Dirty := false;
      spm_entry.setScratchpad(true);
      spm_entry.SrcAddr := in_msg.SrcAddr;
      spm_entry.DstSPMAddr := in_msg.DstSPMAddr;
      spm_entry.SPMSet := spm_set;
      spm_entry.SPMWay := spm_way;
      spm_entry.Len := 64;
    }
  }

  action(spm_installMulticastPending, "spmip", desc="Mark remote SPM slot pending") {
    peek(responseNetwork_in, ResponseMsg) {
      Entry spm_entry := static_cast(Entry, "pointer", cache[in_msg.DstSPMAddr]);
      int spm_set := addressToInt(bitSelect(in_msg.DstSPMAddr, 6, 15));
      int spm_way := addressToInt(bitSelect(in_msg.DstSPMAddr, 16, 18));
      if (is_invalid(spm_entry)) {
        spm_entry := static_cast(Entry, "pointer",
            cache.allocateSPMSlot(in_msg.DstSPMAddr, spm_set, spm_way,
                                  new Entry));
      }
      spm_entry.CacheState := State:XP;
      spm_entry.Dirty := false;
      spm_entry.setScratchpad(true);
      spm_entry.SrcAddr := in_msg.SrcAddr;
      spm_entry.DstSPMAddr := in_msg.DstSPMAddr;
      spm_entry.SPMSet := spm_set;
      spm_entry.SPMWay := spm_way;
      spm_entry.Len := 64;
    }
  }

  action(spm_sendMulticastAck, "spma", desc="Acknowledge remote multicast installation") {
    enqueue(responseNetwork_out, ResponseMsg, l1_response_latency) {
      peek(responseNetwork_in, ResponseMsg) {
        out_msg.addr := in_msg.SrcAddr;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceResponseType:SPM_MCAST_ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Sender);
        out_msg.AckCount := 1;
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  action(spm_decrementMulticastAck, "spmd", desc="Consume one multicast acknowledgement") {
    assert(is_valid(tbe));
    assert(tbe.pendingAcks > 0);
    tbe.pendingAcks := tbe.pendingAcks - 1;
  }

  action(spm_releaseSlot, "sprl", desc="Release private-L1 SPM slot") {
    assert(is_valid(cache_entry));
    cache.releaseSPMSlot(address);
    cache_entry.setScratchpad(false);
    cache_entry.SPMSet := 0;
    cache_entry.SPMWay := 0;
    cache_entry.Len := 0;
    cache.deallocate(address);
    unset_cache_entry();
  }

  action(spm_readHitToL0, "sprh", desc="Return SPM data to L0") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      assert(is_valid(cache_entry));
      assert(cache_entry.isScratchpad());
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_DATA;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := cache.readSPMData(in_msg.DstSPMAddr, in_msg.Len);
      out_msg.Len := in_msg.Len;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    }
  }

  action(spm_readHitToL0_direct, "sprhd", desc="Return SPM data to L0 from direct SPM request path") {
    peek(spmBufferFromL0_in, CoherenceMsg) {
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      assert(is_valid(cache_entry));
      assert(cache_entry.isScratchpad());
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_DATA;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := cache.readSPMData(in_msg.DstSPMAddr, in_msg.Len);
      out_msg.Len := in_msg.Len;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    }
  }

  action(spm_readZeroToL0, "sprz", desc="Return zero for absent/non-SPM SPM read") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_DATA;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := cache.readSPMData(in_msg.DstSPMAddr, in_msg.Len);
      out_msg.Len := in_msg.Len;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    }
  }

  action(spm_readZeroToL0_direct, "sprzd", desc="Return zero for absent/non-SPM direct SPM read") {
    peek(spmBufferFromL0_in, CoherenceMsg) {
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_DATA;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := cache.readSPMData(in_msg.DstSPMAddr, in_msg.Len);
      out_msg.Len := in_msg.Len;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
    }
  }

  action(spm_ackToL0, "spak", desc="Ack SPM write-like operation to L0") {
    spmZeroData.clear();
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_response_latency) {
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_ACK;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := spmZeroData;
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(spm_accessAckToL0, "spaa", desc="Ack pure SPM write through direct SPM datapath") {
    spmZeroData.clear();
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_ACK;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := spmZeroData;
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(spm_accessAckToL0_direct, "spaad", desc="Ack direct-path pure SPM write") {
    spmZeroData.clear();
    enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
      out_msg.addr := address;
      out_msg.Class := CoherenceClass:SPM_ACK;
      out_msg.Sender := machineID;
      out_msg.Dest := createMachineID(MachineType:L0Cache, version);
      out_msg.DataBlk := spmZeroData;
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(spm_storeHit, "spsh", desc="Update SPM data from L0 request") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(cache_entry));
      assert(cache_entry.isScratchpad());
      if (in_msg.SPMMasked) {
        cache.writeSPMDataMasked(in_msg.DstSPMAddr, in_msg.DataBlk,
                                in_msg.Len, in_msg.SPMWriteMask);
      } else {
        cache.writeSPMData(in_msg.DstSPMAddr, in_msg.DataBlk, in_msg.Len);
      }
      cache_entry.Dirty := true;
    }
  }

  action(spm_storeHit_direct, "spshd", desc="Update SPM data from direct SPM request path") {
    peek(spmBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(cache_entry));
      assert(cache_entry.isScratchpad());
      if (in_msg.SPMMasked) {
        cache.writeSPMDataMasked(in_msg.DstSPMAddr, in_msg.DataBlk,
                                in_msg.Len, in_msg.SPMWriteMask);
      } else {
        cache.writeSPMData(in_msg.DstSPMAddr, in_msg.DataBlk, in_msg.Len);
      }
      cache_entry.Dirty := true;
    }
  }

  action(spm_issueSPMWBReq, "spwb", desc="Write SPM data back through L2 home") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(cache_entry));
      assert(cache_entry.isScratchpad());
      cache_entry.SrcAddr := in_msg.SrcAddr;
      cache_entry.DstSPMAddr := address;
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := in_msg.SrcAddr;
        out_msg.SrcAddr := in_msg.SrcAddr;
        out_msg.DstSPMAddr := address;
        out_msg.Len := in_msg.Len;
        out_msg.Type := CoherenceRequestType:SPMWB_REQ;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := true;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(in_msg.SrcAddr, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
      }
    }
  }

  action(i_allocateTBE_flush, "if", desc="Allocate TBE for flush (block not present, will not be present)") {
    check_allocate(TBEs);
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
  }

  action(k_popL0RequestQueue, "k", desc="Pop mandatory queue.") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      if (in_msg.Class == CoherenceClass:SPMCP_FETCH ||
          in_msg.Class == CoherenceClass:SPMWB_STORE) {
        l0WriteCredits.release(in_msg.addr);
      }
    }
    messageBufferFromL0_in.dequeue(clockEdge());
  }

  action(k_spmPopL0RequestQueue, "kspm", desc="Pop direct SPM L0 request queue.") {
    spmBufferFromL0_in.dequeue(clockEdge());
  }

  action(k_popL0ReturnQueue, "kret", desc="Pop ordered L0 recall/eviction return queue.") {
    returnBufferFromL0_in.dequeue(clockEdge());
  }

  action(l_popL2RequestQueue, "l",
         desc="Pop incoming request queue and profile the delay within this virtual network") {
    Tick delay := requestNetwork_in.dequeue(clockEdge());
    profileMsgDelay(2, ticksToCycles(delay));
  }

  action(o_popL2ResponseQueue, "o",
         desc="Pop Incoming Response queue and profile the delay within this virtual network") {
    Tick delay := responseNetwork_in.dequeue(clockEdge());
    profileMsgDelay(1, ticksToCycles(delay));
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {
    assert(!spmSilentRetryTimer.isSet(address));
    missCredits.release(address);
    writeCredits.release(address);
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(u_writeDataFromL0Request, "ureql0", desc="Write data to cache") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      if (in_msg.Class == CoherenceClass:PUTX) {
        l0WriteCredits.release(address);
      }
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
          cache_entry.DataBlk := in_msg.DataBlk;
          cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }

  action(u_writeDataFromL2Response, "uresl2", desc="Write data to cache") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      cache_entry.Dirty := in_msg.Dirty;
    }
  }

  action(u_writeDataFromL0Response, "uresl0", desc="Write data to cache") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
          cache_entry.DataBlk := in_msg.DataBlk;
          cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }

  action(u_writeDataFromEscape, "uresescape", desc="Recall data from independent return lane") {
    peek(returnBufferFromL0_in, CoherenceMsg) {
      if (in_msg.Class == CoherenceClass:PUTX) {
        l0WriteCredits.release(address);
      }
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk := in_msg.DataBlk;
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }

  action(q_updateAckCount, "q", desc="Update ack count") {
    peek(responseNetwork_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.pendingAcks := tbe.pendingAcks - in_msg.AckCount;
      APPEND_TRANSITION_COMMENT(in_msg.AckCount);
      APPEND_TRANSITION_COMMENT(" p: ");
      APPEND_TRANSITION_COMMENT(tbe.pendingAcks);
    }
  }

  action(ff_deallocateCacheBlock, "\f",
         desc="Deallocate L1 cache block.") {
    if (cache.isTagPresent(address)) {
      cache.deallocate(address);
    }
    unset_cache_entry();
  }

  action(oo_allocateCacheBlock, "\o", desc="Set cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(cache.allocate(address, new Entry));
    }
  }

  action(z0_stallAndWaitL0Queue, "\z0", desc="recycle L0 request queue") {
    stall_and_wait(messageBufferFromL0_in, address);
  }

  action(z0_spmStallAndWaitL0Queue, "\z0s", desc="recycle direct SPM L0 request queue") {
    stall_and_wait(spmBufferFromL0_in, address);
  }

  action(z2_stallAndWaitL2Queue, "\z2", desc="recycle L2 request queue") {
    stall_and_wait(requestNetwork_in, address);
  }

  action(z3_stallAndWaitResponseQueue, "\z3", desc="wait for an SPM claim victim from the response network") {
    stall_and_wait(responseNetwork_in, address);
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpAllBuffers(address);
  }

  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    cache.profileDemandMiss();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    cache.profileDemandHit();
  }


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  // Transitions for Load/Store/Replacement/WriteBack from transient states
  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0, MM_IL0, I_F, V_F, D_F},
             {Load, Store, L1_Replacement, Flush, External_Flush_Data, Flush_NP}) {
    z0_stallAndWaitL0Queue;
  }

  transition({SX_L0, MX_L0, EX_L0, SX_A, MX_A, EX_A, IX_A, IX_D, XWB},
             {Load, Store, L1_Replacement, Flush, External_Flush_Data, Flush_NP}) {
    z0_stallAndWaitL0Queue;
  }

  transition({SX_L0, MX_L0, EX_L0, XWB},
             {Fwd_GETS, Fwd_GETX, Inv}) {
    z2_stallAndWaitL2Queue;
  }

  // IX_D still stalls forwarded GETS/GETX (it holds no coherent copy, so these
  // should not target it, but stalling is safe).
  transition(IX_D, {Fwd_GETS, Fwd_GETX}) {
    z2_stallAndWaitL2Queue;
  }

  // F8 fix: in IX_D this core holds NO coherent copy of the source line (it is
  // fetching a snapshot into SPM), but it may still be a STALE L2 sharer from a
  // prior silent SS->I drop.  An Inv from another core's UPGRADE must be
  // acknowledged immediately -- stalling it deadlocks, because the UPGRADE's L2
  // is parked in SS_MB while this core's own GETS_SILENT is queued behind it.
  transition(IX_D, Inv) {
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  // A core mid-SPMCP_fetch that still holds the coherent line (MX_A/EX_A) can
  // service a *normal* coherent GETS just like a plain MM/EE owner: hand data
  // to the requester, write back to L2, and downgrade to the shared SPM-fetch
  // wait state SX_A. The requester becomes a real sharer and will unblock L2,
  // so this does not hang the way a stalled Fwd_GETS would. This core's own
  // SPMCP_fetch still completes via its outstanding PUT and Put_Ack.
  transition({MX_A, EX_A}, Fwd_GETS, SX_A) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popL2RequestQueue;
  }

  // Like M_I -> SINK_WB_ACK: service ownership transfer before our release
  // ack, retaining the SPM snapshot in the existing TBE. Otherwise the home
  // waits for GETX completion while our PUT waits behind that same GETX.
  transition({MX_A, EX_A}, Fwd_GETX, IX_A) {
    spm_bufferCacheData;
    dt_sendDataToRequestor_fromTBE;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition({MX_A, EX_A}, Inv, IX_A) {
    spm_bufferCacheData;
    ft_sendDataToL2_fromTBE;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(SX_A, Fwd_GETS) {
    z2_stallAndWaitL2Queue;
  }

  transition(SX_A, Fwd_GETX, IX_A) {
    spm_bufferCacheData;
    dt_sendDataToRequestor_fromTBE;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(SX_A, Inv, IX_A) {
    spm_bufferCacheData;
    fi_sendInvAck;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(IX_A, Inv) {
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  transition(IX_A, {Fwd_GETS, Fwd_GETX}) {
    z2_stallAndWaitL2Queue;
  }

  transition(IX_A, Fwd_GETS_Silent) {
    spm_bounceSilentGetS;
    l_popL2RequestQueue;
  }

  transition({I, IS, IM, IS_I, IX_A}, Fwd_GETS_SilentRetry) {
    spm_nackSilentGetS;
    l_popL2RequestQueue;
  }

  transition(IX_D, SPM_SilentRetry) {
    spm_rememberSilentRetry;
    o_popL2ResponseQueue;
  }

  transition(IX_D, SPM_SilentReissue) {
    spm_reissueSilentGetS;
  }

  // Silent SPM snapshot: the data is resident in this L1 (MM/EE) or this core
  // is itself mid-SPMCP_fetch but still holds the coherent line (MX_A/EX_A).
  // Fire-and-forget: hand back a copy and nothing else -- the home never
  // blocked (MT stays MT) so there is no Unblock to send and this owner's
  // coherence state is untouched.
  transition({MM, EE, MX_A, EX_A}, Fwd_GETS_Silent) {
    spm_sendSilentDataToRequestor;
    l_popL2RequestQueue;
  }

  // A clean shared copy is an equally valid snapshot: serve it directly.
  // Reachable because a fire-and-forget forward can race this core's
  // ownership downgrade (the home's registration was momentarily stale).
  transition({S, SS, SM}, Fwd_GETS_Silent) {
    spm_sendSilentDataToRequestor;
    l_popL2RequestQueue;
  }

  // Ownerless: our WB_Ack overtook the forward on the unordered vnets and
  // the line (and its TBE) is gone.  BOUNCE the request back to the home,
  // which has absorbed -- or is absorbing -- the writeback and will serve or
  // re-forward it.  Verified in cacheflex_spm_mc.m (FNF_SILENT=1).
  transition({I, IS, IM, IS_I}, Fwd_GETS_Silent) {
    spm_bounceSilentGetS;
    l_popL2RequestQueue;
  }

  // A DYING owner (M_I, mid-writeback) serves the snapshot from its
  // writeback TBE and keeps dying.  Fire-and-forget: the home never blocked,
  // so the in-flight PUTX resolves the directory by itself (the F6
  // WB_Data-to-L2 handshake existed only to unwedge MT_SPMS).
  transition(M_I, Fwd_GETS_Silent) {
    spm_sendSilentDataToRequestor_fromTBE;
    l_popL2RequestQueue;
  }

  // The freshest data has not settled into this L1 yet (still recalling L0 for
  // our own SPMCP_fetch, installing, or writing back). Stall until it has, then
  // the transition above fires.
  transition({SX_L0, MX_L0, EX_L0, IX_D, XWB, SINK_WB_ACK}, Fwd_GETS_Silent) {
    z2_stallAndWaitL2Queue;
  }

  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0,
              MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0,
              SX_A, MX_A, EX_A, IX_A, XWB, XC},
             {SPMCP_snapshot, SPMCP_fetch, SPMCP_install, SPMLD, SPMST, SPMWB_read,
              SPMWB_store, SPM_release}) {
    z0_stallAndWaitL0Queue;
  }

  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0,
              MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0,
              SX_A, MX_A, EX_A, IX_A, XWB, XC},
             {SPMLD_direct, SPMST_direct, SPMWB_read_direct}) {
    z0_spmStallAndWaitL0Queue;
  }

  // Routing/completion does not consult private cache residency. In particular,
  // a copy's coherent source may have been refetched before its remote ACK.
  transition({SM_IL0, L3_SEND, L3_WB_READ, L3_WB_SEND, I, S, SS, E, EE, M, MM, X, IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0, MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0, SX_A, MX_A, EX_A, IX_A, XWB, XC, XP, XM}, L3Forward) {
    l3_forward;
    k_popL0RequestQueue;
  }
  transition({SM_IL0, L3_SEND, L3_WB_READ, L3_WB_SEND, I, S, SS, E, EE, M, MM, X, IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0, MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0, SX_A, MX_A, EX_A, IX_A, XWB, XC, XP, XM}, L3ForwardDirect) {
    l3_forwardDirect;
    k_spmPopL0RequestQueue;
  }
  transition({SM_IL0, L3_SEND, L3_WB_READ, L3_WB_SEND, I, S, SS, E, EE, M, MM, X, IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0, MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0, SX_A, MX_A, EX_A, IX_A, XWB, XC, XP, XM}, L3Reply) {
    l3_reply;
    o_popL2ResponseQueue;
  }
  transition(I, L3ForwardWB, L3_WB_READ) {
    spm_allocateTBE; l3_forward; k_popL0RequestQueue;
  }
  transition(L3_WB_READ, L3WritebackData, L3_WB_SEND) {
    spm_bufferResponseData; l3_schedule; o_popL2ResponseQueue;
  }
  transition(L3_WB_SEND, L3Send, I) {
    l3_writeback; s_deallocateTBE; kd_wakeUpDependents;
  }

  transition(IX_D, L3SourceData, L3_SEND) {
    spm_bufferResponseData; l3_schedule; o_popL2ResponseQueue;
  }
  transition(IX_A, L3SourceAck, L3_SEND) {
    l3_schedule; o_popL2ResponseQueue;
  }
  transition({SX_A, MX_A, EX_A}, L3SourceAck, L3_SEND) {
    spm_bufferCacheData; l3_schedule; ff_deallocateCacheBlock; o_popL2ResponseQueue;
  }
  transition(L3_SEND, L3Send, I) {
    l3_sendInstall; s_deallocateTBE; kd_wakeUpDependents;
  }
  transition(L3_SEND, {Load, Store, L1_Replacement, Flush, External_Flush_Data, Flush_NP,
             SPMCP_snapshot, SPMCP_fetch, SPMCP_install, SPMLD, SPMST, SPMWB_read, SPMWB_store, SPM_release}) {
    z0_stallAndWaitL0Queue;
  }
  transition(L3_SEND, {SPMLD_direct, SPMST_direct, SPMWB_read_direct}) {
    z0_spmStallAndWaitL0Queue;
  }
  transition(L3_SEND, {Inv, Fwd_GETS, Fwd_GETX, Fwd_GETS_Silent}) {
    z2_stallAndWaitL2Queue;
  }

  // The source snapshot was captured at L0 before any later coherent eviction.
  // Install from the existing TBE so lazy slot migration cannot alias the source.
  transition({I, S, E, M, SS, EE, MM}, SPMCP_snapshot) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    spm_bufferL0Snapshot;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
  }

  transition(I, SPMCP_fetch, IX_D) {
    spm_allocateTBE;
    micro_miss;
    spm_sendMulticastPending;
    spm_issueGETSSilent;
    k_popL0RequestQueue;
  }

  // L0 hits carry snapshots above. If an earlier eviction raced the request,
  // retain the existing recall fallback, but never release ownership to LLC.
  transition(S, SPMCP_fetch, SX_L0) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    forward_eviction_to_L0_own;
    k_popL0RequestQueue;
  }

  transition(SS, SPMCP_fetch) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
  }

  transition(E, SPMCP_fetch, EX_L0) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    forward_eviction_to_L0_own;
    k_popL0RequestQueue;
  }

  transition(EE, SPMCP_fetch) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
  }

  transition(M, SPMCP_fetch, MX_L0) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    forward_eviction_to_L0_own;
    k_popL0RequestQueue;
  }

  transition(MM, SPMCP_fetch) {
    spm_allocateTBE;
    spm_sendMulticastPending;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
  }

  transition(SX_L0, L0_Ack, SS) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(SX_L0, L0_AckEscape, SS) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE; k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(SX_L0, L0_DataAckEscape, SS) {
    u_writeDataFromEscape; spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE; k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(EX_L0, L0_AckEscape, EE) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE; k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition({EX_L0, MX_L0}, L0_DataAckEscape, MM) {
    u_writeDataFromEscape; spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE; k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(MX_L0, L0_AckEscape, MM) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE; k_popL0ReturnQueue; kd_wakeUpDependents;
  }

  transition(SX_L0, {L0_DataAck, L0_DataCopy}, SS) {
    u_writeDataFromL0Response;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(EX_L0, L0_Ack, EE) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  // F7 fix: L0 returned DIRTY data (an un-written-back store on the exclusive
  // source), so the coherent source is now Modified -> rest in MM, not EE.
  // The old EE-with-Dirty target lost the store on a later EE+Inv->I (which
  // "don't send data").  MM answers Inv with data, so the store survives.
  transition(EX_L0, {L0_DataAck, L0_DataCopy}, MM) {
    u_writeDataFromL0Response;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  // F2 fix: an L0 capacity eviction (PUTX/WriteBack) can race the SPMCP_fetch
  // L0-recall and arrive while in EX_L0/MX_L0, which had no transition (panic).
  // Absorb the writeback data and settle into MX_L0: if the writeback was
  // dirty the source is now Modified (its recall completes to MM); a clean
  // writeback is conservatively treated as modified (a harmless redundant
  // writeback of identical data), never as clean-exclusive with lost data.
  transition({EX_L0, MX_L0}, WriteBack, MX_L0) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
  }

  transition({EX_L0, MX_L0}, WriteBackEscape, MX_L0) {
    u_writeDataFromEscape;
    k_popL0ReturnQueue;
  }

  transition(MX_L0, {L0_DataAck, L0_DataCopy}, MM) {
    u_writeDataFromL0Response;
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(MX_L0, L0_Ack, MM) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(MX_L0, L0_DataNak, MM) {
    spm_bufferCacheData;
    spm_installFromTBE;
    spm_sendRetainedMulticast;
    spm_ackToL0;
    s_deallocateTBE;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(IX_D, {Data_all_Acks, Data_Exclusive, DataS_fromL1}, X) {
    spm_bufferResponseData;
    spm_installFromTBE;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IX_D, SPM_McastSourceData, I) {
    spm_bufferResponseData;
    spm_installFromTBE;
    spm_sendMulticastFromTBE;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IX_A, Put_Ack, I) {
    spm_installFromTBE;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IX_A, SPM_McastPutAck, I) {
    spm_installFromTBE;
    spm_sendMulticastFromTBE;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition({SX_A, MX_A, EX_A}, Put_Ack, X) {
    spm_installFromCache;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition({SX_A, MX_A, EX_A}, SPM_McastPutAck, I) {
    spm_bufferCacheData;
    spm_installFromCache;
    spm_sendMulticastFromTBE;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition({I, X, XP}, SPM_McastData, X) {
    spm_installMulticastData;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition({I, X}, SPM_McastPending, XP) {
    spm_installMulticastPending;
    o_popL2ResponseQueue;
  }

  transition(XP, SPM_McastPending, XP) {
    o_popL2ResponseQueue;
  }

  transition({I, X}, SPM_McastClaim, X) {
    spm_installMulticastClaim;
    spm_sendMulticastClaimAck;
    o_popL2ResponseQueue;
  }

  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, E_IL0,
              MM_IL0, I_F, V_F, D_F, IX_D, SX_L0, MX_L0, EX_L0,
              SX_A, MX_A, EX_A, IX_A, XWB, XC}, SPM_McastClaimWait) {
    z3_stallAndWaitResponseQueue;
  }

  transition({I, S, SS, E, EE, M, MM, X}, SPM_McastClaimLocal, XC) {
    spm_allocateTBE;
    spm_claimSlot;
    spm_sendMulticastClaim;
    k_popL0RequestQueue;
  }

  transition(XC, SPM_McastClaimAck) {
    spm_decrementMulticastAck;
    o_popL2ResponseQueue;
  }

  transition(XC, SPM_McastClaimLastAck, X) {
    spm_decrementMulticastAck;
    spm_claimAckToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(XM, SPM_McastAck) {
    spm_decrementMulticastAck;
    o_popL2ResponseQueue;
  }

  transition(XM, SPM_McastLastAck, I) {
    spm_decrementMulticastAck;
    spm_ackToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition({I, S, SS, E, EE, M, MM}, SPMCP_install, X) {
    spm_claimSlot;
    spm_ackToL0;
    k_popL0RequestQueue;
  }

  transition({I, S, SS, E, EE, M, MM}, {SPMLD, SPMWB_read}) {
    spm_readZeroToL0;
    k_popL0RequestQueue;
  }

  transition({I, S, SS, E, EE, M, MM}, {SPMLD_direct, SPMWB_read_direct}) {
    spm_readZeroToL0_direct;
    k_spmPopL0RequestQueue;
  }

  transition({I, S, SS, E, EE, M, MM}, SPMST) {
    spm_accessAckToL0;
    k_popL0RequestQueue;
  }

  transition({I, S, SS, E, EE, M, MM}, SPMST_direct) {
    spm_accessAckToL0_direct;
    k_spmPopL0RequestQueue;
  }

  transition({I, S, SS, E, EE, M, MM}, {SPMWB_store, SPM_release}) {
    spm_ackToL0;
    k_popL0RequestQueue;
  }

  transition(X, {SPMLD, SPMWB_read}, X) {
    spm_readHitToL0;
    k_popL0RequestQueue;
  }

  transition(X, {SPMLD_direct, SPMWB_read_direct}, X) {
    spm_readHitToL0_direct;
    k_spmPopL0RequestQueue;
  }

  // Some SPM vector load paths can arrive at the private L1 as a load-class
  // request while targeting a scratchpad-owned slot.  Treat this as an SPM
  // slot read instead of rejecting the otherwise-valid X-state access.
  transition(X, Load, X) {
    spm_readHitToL0;
    k_popL0RequestQueue;
  }

  transition(X, SPMST, X) {
    spm_storeHit;
    spm_accessAckToL0;
    k_popL0RequestQueue;
  }

  transition(X, SPMST_direct, X) {
    spm_storeHit_direct;
    spm_accessAckToL0_direct;
    k_spmPopL0RequestQueue;
  }

  transition(X, SPMWB_store, XWB) {
    spm_issueSPMWBReq;
    k_popL0RequestQueue;
  }

  transition(XWB, SPMWB_Ack, X) {
    spm_ackToL0;
    o_popL2ResponseQueue;
  }

  transition(X, SPM_release, I) {
    spm_ackToL0;
    spm_releaseSlot;
    k_popL0RequestQueue;
  }

  transition(X, {L1_Replacement, Inv, Fwd_GETX, Fwd_GETS}) {
    z2_stallAndWaitL2Queue;
  }

  transition(XP, {SPMLD, SPMST, SPMWB_read, SPMWB_store, SPM_release}) {
    z0_stallAndWaitL0Queue;
  }

  transition(XP, {SPMLD_direct, SPMST_direct, SPMWB_read_direct}) {
    z0_spmStallAndWaitL0Queue;
  }

  transition(XP, {L1_Replacement, Inv, Fwd_GETX, Fwd_GETS}) {
    z2_stallAndWaitL2Queue;
  }

  transition(I, Load, IS) {
    oo_allocateCacheBlock;
    i_allocateTBE;
    micro_miss;
    a_issueGETS;
    uu_profileMiss;
    k_popL0RequestQueue;
  }

  transition(I, Store, IM) {
    oo_allocateCacheBlock;
    i_allocateTBE;
    micro_miss;
    b_issueGETX;
    uu_profileMiss;
    k_popL0RequestQueue;
  }

  transition(I, Inv) {
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  // Transitions from Shared
  transition({S,SS}, Load, S) {
    h_data_to_l0;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  transition({S,SS}, Store, SM) {
    i_allocateTBE;
    micro_miss;
    c_issueUPGRADE;
    uu_profileMiss;
    k_popL0RequestQueue;
  }

  transition(SS, L1_Replacement, I) {
    ff_deallocateCacheBlock;
  }

  transition(S, L0_Invalidate_Own, S_IL0) {
    forward_eviction_to_L0_own;
  }

  transition(S, L0_Invalidate_Else, S_IL0) {
    forward_eviction_to_L0_else;
  }

  transition(SS, Inv, I) {
    fi_sendInvAck;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  // Transitions from Exclusive

  transition({EE,MM}, Store, M) {
    hh_xdata_to_l0;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  transition(EE, L1_Replacement, M_I) {
    // silent E replacement??
    i_allocateTBE;
    micro_write;
    g_issuePUTX;   // send data, but hold in case forwarded request
    ff_deallocateCacheBlock;
  }

  transition(EE, Inv, I) {
    // don't send data
    fi_sendInvAck;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(EE, Fwd_GETX, I) {
    d_sendDataToRequestor;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(EE, Fwd_GETS, SS) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popL2RequestQueue;
  }

  transition(E, L0_Invalidate_Own, E_IL0) {
    forward_eviction_to_L0_own;
  }

  transition(E, L0_Invalidate_Else, E_IL0) {
    forward_eviction_to_L0_else;
  }

  // Transitions from Modified
  transition(MM, L1_Replacement, M_I) {
    i_allocateTBE;
    micro_write;
    g_issuePUTX;   // send data, but hold in case forwarded request
    ff_deallocateCacheBlock;
  }

  transition({M,E}, WriteBack, MM) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
  }

  transition({M,E}, WriteBackEscape, MM) {
    u_writeDataFromEscape;
    k_popL0ReturnQueue;
  }

  transition(M_I, WB_Ack, I) {
    s_deallocateTBE;
    o_popL2ResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition(MM, Inv, I) {
    f_sendDataToL2;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(M_I, Inv, SINK_WB_ACK) {
    ft_sendDataToL2_fromTBE;
    l_popL2RequestQueue;
  }

  transition(MM, Fwd_GETX, I) {
    d_sendDataToRequestor;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition(MM, Fwd_GETS, SS) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popL2RequestQueue;
  }

  transition(M, L0_Invalidate_Own, M_IL0) {
    forward_eviction_to_L0_own;
  }

  transition(M, L0_Invalidate_Else, M_IL0) {
    forward_eviction_to_L0_else;
  }

  transition(M_I, Fwd_GETX, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    l_popL2RequestQueue;
  }

  transition(M_I, Fwd_GETS, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    d2t_sendDataToL2_fromTBE;
    l_popL2RequestQueue;
  }

  // Transitions from IS
  transition({IS,IS_I}, Inv, IS_I) {
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  transition(IS, Data_all_Acks, S) {
    u_writeDataFromL2Response;
    h_data_to_l0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, Data_all_Acks, I) {
    u_writeDataFromL2Response;
    h_stale_data_to_l0;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, DataS_fromL1, S) {
    u_writeDataFromL2Response;
    j_sendUnblock;
    h_data_to_l0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, DataS_fromL1, I) {
    u_writeDataFromL2Response;
    j_sendUnblock;
    h_stale_data_to_l0;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  // directory is blocked when sending exclusive data
  transition({IS,IS_I}, Data_Exclusive, E) {
    u_writeDataFromL2Response;
    hh_xdata_to_l0;
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  // Transitions from IM
  transition(IM, Inv, IM) {
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  transition(IM, Data, SM) {
    u_writeDataFromL2Response;
    q_updateAckCount;
    o_popL2ResponseQueue;
  }

  transition(IM, Data_all_Acks, M) {
    u_writeDataFromL2Response;
    hh_xdata_to_l0;
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition({SM, IM}, Ack) {
    q_updateAckCount;
    o_popL2ResponseQueue;
  }

  transition(SM, Ack_all, M) {
    jj_sendExclusiveUnblock;
    hh_xdata_to_l0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM, {Inv,L0_Invalidate_Else}, SM_IL0) {
    forward_eviction_to_L0_else;
  }

  transition(SINK_WB_ACK, Inv){
    fi_sendInvAck;
    l_popL2RequestQueue;
  }

  transition(SINK_WB_ACK, WB_Ack, I){
    s_deallocateTBE;
    o_popL2ResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition({M_IL0, E_IL0}, WriteBack, MM_IL0) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({M_IL0, E_IL0}, WriteBackEscape, MM_IL0) {
    u_writeDataFromEscape;
    k_popL0ReturnQueue;
    kd_wakeUpDependents;
  }

  transition({M_IL0, E_IL0}, L0_DataAck, MM) {
    u_writeDataFromL0Response;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({M_IL0, E_IL0}, L0_DataAckEscape, MM) {
    u_writeDataFromEscape; k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition({M_IL0, MM_IL0}, L0_AckEscape, MM) {
    k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(E_IL0, L0_AckEscape, EE) {
    k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(S_IL0, L0_AckEscape, SS) {
    k_popL0ReturnQueue; kd_wakeUpDependents;
  }
  transition(SM_IL0, L0_AckEscape, IM) {
    k_popL0ReturnQueue; kd_wakeUpDependents;
  }

  transition({M_IL0, MM_IL0}, L0_Ack, MM) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(E_IL0, L0_Ack, EE) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(S_IL0, L0_Ack, SS) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(SM_IL0, L0_Ack, IM) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({S_IL0, M_IL0, E_IL0, SM_IL0, SM}, L0_Invalidate_Own) {
    z0_stallAndWaitL0Queue;
  }

  transition({S_IL0, M_IL0, E_IL0, SM_IL0}, L0_Invalidate_Else) {
    z2_stallAndWaitL2Queue;
  }

  transition({S_IL0, M_IL0, E_IL0, MM_IL0}, {Inv, Fwd_GETX, Fwd_GETS, Fwd_GETS_Silent}) {
    z2_stallAndWaitL2Queue;
  }

  // hardware transactional memory

  // If a transaction has aborted, the L0 could re-request
  // data which is in E or EE state in L1.
  transition({EE,E}, Load, E) {
    hh_xdata_to_l0;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  // If a transaction has aborted, the L0 could re-request
  // data which is in M or MM state in L1.
  transition({MM,M}, Load, M) {
    hh_xdata_to_l0;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  // If a transaction has aborted, the L0 could re-request
  // data which is in M state in L1.
  transition({E,M}, Store, M) {
    hh_xdata_to_l0;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  // A transaction may have tried to modify a cache block in M state with
  // non-speculative (pre-transactional) data. This needs to be copied
  // to the L1 before any further modifications occur at the L0.
  transition({M,E}, L0_DataCopy, M) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
  }

  transition({M_IL0, E_IL0}, L0_DataCopy, M_IL0) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
  }

  // A NAK from the L0 means that the L0 invalidated its
  // modified line (due to an abort) so it is therefore necessary
  // to use the L1's correct version instead
  transition({M_IL0, E_IL0}, L0_DataNak, MM) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(I, L1_Replacement) {
    ff_deallocateCacheBlock;
  }

  // flush transitions
  transition(I, Flush_NP, I_F) {
    i_allocateTBE_flush;
    f_sendFlushNPToL2;
    k_popL0RequestQueue;
  }

  transition({S, SS, E, EE, M, MM}, {Flush, Flush_NP}, V_F) {
    i_allocateTBE;
    f_sendFlushToL2;
    k_popL0RequestQueue;
  }

  transition(V_F, Flush_Ack, I) {
    f_sendFlushAckToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition(I_F, Flush_Ack, I) {
    f_sendFlushAckToL0;
    s_deallocateTBE;
    o_popL2ResponseQueue;
    kd_wakeUpDependents;
  }

  transition({EE, MM}, External_Flush_Data, I) {
    f_sendFlushDataToL2;
    ff_deallocateCacheBlock;
    l_popL2RequestQueue;
  }

  transition({E,M}, External_Flush_Data, D_F) {
    i_allocateTBE;
    f_fwdFlushDataReqToL0;
    l_popL2RequestQueue;
  }

  transition(D_F, External_Flush_Data_Ack, I) {
    f_fwdFlushDataToL2;
    ff_deallocateCacheBlock;
    k_popL0RequestQueue;
  }
}
