machine(MachineType:L1Cache, "MESI Directory L1 Cache CMP")
 : CacheMemory * cache;
   MicroResourcePool * missCredits;
   MicroResourcePool * writeCredits;
   MicroResourcePool * l0WriteCredits;
   int l2_select_num_bits;
   Cycles l1_request_latency := 2;
   Cycles l1_response_latency := 2;
   // Pure spm_ld/spm_st accesses model the paper's dedicated private-L2 SPM
   // datapath: physical way/slot addressing with no tag/TLB/coherence lookup.
   // Bridge/control operations keep the original response latency because they
   // still coordinate with the coherent cache pipeline.
   Cycles spm_access_response_latency := 1;
   Cycles spm_response_latency := 6;
   Cycles to_l2_latency := 1;
   bool spm_silent_retry := "False";
   bool l3_spm_enabled := "False";
   Cycles spm_silent_retry_latency := 8;

   // Message Buffers between the L1 and the L0 Cache
   // From the L1 cache to the L0 cache
   MessageBuffer * bufferToL0, network="To";

   // Dedicated private-L1 SPM response path.
   MessageBuffer * spmBufferToL0, network="To";

   // From the L0 cache to the L1 cache
   MessageBuffer * bufferFromL0, network="From";

   // Dedicated pure-SPM request path from the private L0 controller.
   MessageBuffer * spmBufferFromL0, network="From";
   MessageBuffer * returnBufferFromL0, network="From";

   // Message queue from this L1 cache TO the network / L2
   MessageBuffer * requestToL2, network="To", virtual_network="0",
        vnet_type="request";

   MessageBuffer * responseToL2, network="To", virtual_network="1",
        vnet_type="response";
   MessageBuffer * unblockToL2, network="To", virtual_network="2",
        vnet_type="unblock";

   // To this L1 cache FROM the network / L2
   MessageBuffer * requestFromL2, network="From", virtual_network="2",
        vnet_type="request";
   MessageBuffer * responseFromL2, network="From", virtual_network="1",
        vnet_type="response";

{
  // STATES
  state_declaration(State, desc="Cache states", default="L1Cache_State_I") {
    // Base states
    I, AccessPermission:Invalid, desc="L1 cache entry Idle";
    S, AccessPermission:Read_Only, desc="Line is present in shared state in L1 and L0";
    SS, AccessPermission:Read_Only, desc="Line is present in shared state in L1 but not L0";
    E, AccessPermission:Read_Only, desc="Line is present in exclusive state in L1 and L0";
    EE, AccessPermission:Read_Write, desc="Line is present in exclusive state in L1 but not L0";
    M, AccessPermission:Maybe_Stale, desc="Line is present in modified state in L1 and present in L0", format="!b";
    MM, AccessPermission:Read_Write, desc="Line is present in modified state in L1 but not present in L0", format="!b";
    X, AccessPermission:Read_Write, desc="Private L1 scratchpad slot outside coherence domain";

    // Transient States
    IS, AccessPermission:Busy, desc="L1 idle, issued GETS, have not seen response yet";
    IM, AccessPermission:Busy, desc="L1 idle, issued GETX, have not seen response yet";
    SM, AccessPermission:Read_Only, desc="L1 idle, issued GETX, have not seen response yet";
    IS_I, AccessPermission:Busy, desc="L1 idle, issued GETS, saw Inv before data because directory doesn't block on GETS hit";
    M_I, AccessPermission:Busy, desc="L1 replacing, waiting for ACK";
    SINK_WB_ACK, AccessPermission:Busy, desc="This is to sink WB_Acks from L2";

    // For all of the following states, invalidate
    // message has been sent to L0 cache. The response
    // from the L0 cache has not been seen yet.
    S_IL0, AccessPermission:Read_Only, desc="Shared in L1, invalidation sent to L0, have not seen response yet";
    E_IL0, AccessPermission:Maybe_Stale, desc="Exclusive in L1, invalidation sent to L0, have not seen response yet";
    M_IL0, AccessPermission:Maybe_Stale, desc="Modified in L1, invalidation sent to L0, have not seen response yet";
    MM_IL0, AccessPermission:Read_Write, desc="Invalidation sent to L0, have not seen response yet";
    SM_IL0, AccessPermission:Busy, desc="Invalidation sent to L0, have not seen response yet";

    // Flush states
    I_F, AccessPermission:Busy, desc="Send flush to L2, entry is invalid";
    V_F, AccessPermission:Busy, desc="Send flush to L2, entry is valid";
    D_F, AccessPermission:Busy, desc="Sending data to L2 during flush";
    IX_D, AccessPermission:Busy, desc="SPMCP_fetch source absent; issued GETS_SILENT";
    SX_L0, AccessPermission:Busy, desc="SPMCP_fetch source shared; recalling L0";
    MX_L0, AccessPermission:Busy, desc="SPMCP_fetch source modified; recalling L0";
    EX_L0, AccessPermission:Busy, desc="SPMCP_fetch source exclusive; recalling L0";
    SX_A, AccessPermission:Busy, desc="SPMCP_fetch source shared; sent PUTS";
    MX_A, AccessPermission:Busy, desc="SPMCP_fetch source modified; sent PUTM";
    IX_A, AccessPermission:Busy, desc="SPM snapshot buffered; coherent ownership relinquished; waiting for Put_Ack";
    EX_A, AccessPermission:Busy, desc="SPMCP_fetch source exclusive; sent PUTE";
    XWB, AccessPermission:Busy, desc="SPM writeback request outstanding";
    XM, AccessPermission:Busy, desc="Waiting for multicast SPM install acknowledgements";
    XC, AccessPermission:Busy, desc="Waiting for multicast SPM way-claim acknowledgements";
    XP, AccessPermission:Busy, desc="Receiver SPM slot awaiting multicast data";
    L3_SEND, AccessPermission:Busy, desc="Released coherent source snapshot in existing TBE, awaiting shared install issue";
    L3_WB_READ, AccessPermission:Busy, desc="Existing TBE reserved for shared writeback snapshot";
    L3_WB_SEND, AccessPermission:Busy, desc="Shared snapshot buffered until coherent writeback can issue";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {
    // Requests from the L0 cache
    Load,            desc="Load request";
    Store,           desc="Store request";
    WriteBack,       desc="Writeback request";

    // Responses from the L0 Cache
    // L0 cache received the invalidation message
    // and has sent the data.
    L0_DataAck,      desc="L0 received INV message";
    L0_DataAckEscape, desc="Recall data on finite independent return lane";
    L0_AckEscape, desc="Recall acknowledgement on finite return lane";
    WriteBackEscape, desc="L0 eviction ordered with recall responses";

    Inv,           desc="Invalidate request from L2 bank";

    // internally generated requests:
    L0_Invalidate_Own,  desc="Invalidate line in L0, due to this cache's (L1) requirements";
    L0_Invalidate_Else, desc="Invalidate line in L0, due to another cache's requirements";
    L1_Replacement,     desc="Invalidate line in this cache (L1), due to another cache's requirements";

    // other requests
    Fwd_GETX,   desc="GETX from other processor";
    Fwd_GETS,   desc="GETS from other processor";
    Fwd_GETS_Silent, desc="Silent SPM-copy GETS from another core; supply a data snapshot without changing this owner's coherence state";
    Fwd_GETS_SilentRetry, desc="Stale silent owner returns NACK instead of request-channel bounce";
    SPM_SilentRetry, desc="Consume NACK into existing fetch TBE, without blocking response network";
    SPM_SilentReissue, desc="Reissue a NACKed fetch using its existing miss credit and TBE";

    Data,       desc="Data for processor";
    Data_Exclusive,       desc="Data for processor";
    DataS_fromL1,       desc="data for GETS request, need to unblock directory";
    Data_all_Acks,       desc="Data for processor, all acks";

    L0_Ack,        desc="Ack for processor";
    Ack,        desc="Ack for processor";
    Ack_all,      desc="Last ack for processor";

    WB_Ack,        desc="Ack for replacement";

    // hardware transactional memory
    L0_DataCopy,     desc="Data Block from L0. Should remain in M state.";

    // L0 cache received the invalidation message and has
    // sent a NAK (because of htm abort) saying that the data
    // in L1 is the latest value.
    L0_DataNak,      desc="L0 received INV message, specifies its data is also stale";

    Flush,     desc="Flush request from L0, valid in L0";
    Flush_NP,   desc="Flush request from L0, not present in L0";
    Flush_Ack,  desc="Flush ack from L1";
    External_Flush_Data, desc="Send flush data to L2";
    External_Flush_Data_Ack, desc="Flush data received from L1";

    // Pure SPM requests arriving on the dedicated L0->private-L1 SPM path.
    SPMLD_direct,       desc="Direct SPM load request";
    SPMST_direct,       desc="Direct SPM store request";
    SPMWB_read_direct,  desc="Direct SPM writeback source read request";

    SPMCP_snapshot, desc="Install retained L0 snapshot without coherent ownership change";
    SPMCP_fetch, desc="Copy coherent source line into private-L1 SPM";
    SPMCP_install, desc="Claim private-L1 SPM slot";
    SPMLD, desc="Read private-L1 SPM slot";
    SPMST, desc="Write private-L1 SPM slot";
    SPMWB_read, desc="Read private-L1 SPM slot for writeback";
    SPMWB_store, desc="Write private-L1 SPM data back";
    SPM_release, desc="Release private-L1 SPM slot";
    Put_Ack, desc="SPM source release ack";
    SPMWB_Ack, desc="SPM writeback ack";
    SPM_McastSourceData, desc="Source data ready for multicast distribution";
    SPM_McastPutAck, desc="Resident source released and ready for multicast";
    SPM_McastData, desc="Unsolicited multicast SPM installation data";
    SPM_McastPending, desc="Multicast destination announced before data";
    SPM_McastAck, desc="Remote multicast install acknowledgement";
    SPM_McastLastAck, desc="Last remote multicast install acknowledgement";
    SPM_McastClaimLocal, desc="Initiate a multicast SPM way claim";
    SPM_McastClaim, desc="Remote multicast SPM way claim";
    SPM_McastClaimAck, desc="Remote multicast way-claim acknowledgement";
    SPM_McastClaimLastAck, desc="Last remote multicast way-claim acknowledgement";
    SPM_McastClaimWait, desc="Remote way claim waiting for coherent victim eviction";
    L3Forward, desc="Forward ordinary-ingress shared SPM request";
    L3ForwardWB, desc="Reserve finite snapshot tracking before shared writeback";
    L3ForwardDirect, desc="Forward direct-ingress shared SPM request";
    L3Reply, desc="Shared SPM result to local sequencer";
    L3WritebackData, desc="Shared SPM payload to coherent writeback home";
    L3SourceData, desc="Fresh source response for remote installation";
    L3SourceAck, desc="Coherent source released for remote installation";
    L3Send, desc="Issue buffered remote install without holding a response FIFO";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry" ) {
    State CacheState,        desc="cache state";
    DataBlock DataBlk,       desc="data for the block";
    bool Dirty, default="false",   desc="data is dirty";
    Addr SrcAddr, default="0", desc="Coherent source address for active SPM op";
    Addr DstSPMAddr, default="0", desc="Encoded SPM destination slot address";
    int SPMSet, default="0", desc="Decoded SPM set index";
    int SPMWay, default="0", desc="Decoded SPM way id";
    int Len, default="0", desc="SPM operation length";
    int MulticastMask, default="0", desc="Destination private-L1 core mask";
  }

  // TBE fields
  structure(TBE, desc="...") {
    RubyAccessMode SilentAccessMode, desc="Preserved access mode for silent fetch retry";
    Addr addr,              desc="Physical address for this TBE";
    State TBEState,        desc="Transient state";
    DataBlock DataBlk,                desc="Buffer for the data block";
    bool Dirty, default="false",   desc="data is dirty";
    int pendingAcks, default="0", desc="number of pending acks";
    Addr SrcAddr, default="0", desc="Coherent source address for active SPM op";
    Addr DstSPMAddr, default="0", desc="Encoded SPM destination slot address";
    int SPMSet, default="0", desc="Decoded SPM set index";
    int SPMWay, default="0", desc="Decoded SPM way id";
    int Len, default="0", desc="SPM operation length";
    int MulticastMask, default="0", desc="Destination private-L1 core mask";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  TBETable TBEs, template="<L1Cache_TBE>", constructor="m_number_of_TBEs";
  // At most one retry marker per live IX_D TBE; not an extra request/data queue.
  // TimerTable supplies simulator scheduling for a pending bit in that TBE.
  TimerTable spmSilentRetryTimer;
  TimerTable l3SendTimer;
  DataBlock spmZeroData;

  int l2_select_low_bit, default="m_ruby_system->getBlockSizeBits()";

  Tick clockEdge();
  Tick cyclesToTicks(Cycles c);
  Cycles ticksToCycles(Tick t);
  void set_cache_entry(AbstractCacheEntry a);
  void unset_cache_entry();
  void set_tbe(TBE a);
  void unset_tbe();
  void wakeUpBuffers(Addr a);
  void wakeUpAllBuffers(Addr a);
  void profileMsgDelay(int virtualNetworkType, Cycles c);

  // inclusive cache returns L1 entries only
  bool isL3SPM(Addr addr) {
    return bitSelect(addr, 27, 27) == intToAddress(1);
  }

  MessageSizeType l3DataSize(int len) {
    if (len > 128) { return MessageSizeType:SPM_Data256; }
    if (len > 64) { return MessageSizeType:SPM_Data128; }
    return MessageSizeType:Data;
  }

  int l3Operation(CoherenceClass kind) {
    if (kind == CoherenceClass:SPM_LD || kind == CoherenceClass:SPMWB_READ) { return 1; }
    if (kind == CoherenceClass:SPM_ST) { return 2; }
    if (kind == CoherenceClass:SPM_RELEASE) { return 3; }
    if (kind == CoherenceClass:SPMWB_STORE) { return 5; }
    if (kind == CoherenceClass:SPMCP_INSTALL) { return 6; }
    error("Unsupported shared SPM operation");
  }

  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry cache_entry := static_cast(Entry, "pointer", cache[addr]);
    return cache_entry;
  }

  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    if(is_valid(tbe)) {
      return tbe.TBEState;
    } else if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    }
    return State:I;
  }

  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    // MUST CHANGE
    if(is_valid(tbe)) {
      tbe.TBEState := state;
    }

    if (is_valid(cache_entry)) {
      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      DPRINTF(RubySlicc, "%s\n", L1Cache_State_to_permission(tbe.TBEState));
      return L1Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      DPRINTF(RubySlicc, "%s\n", L1Cache_State_to_permission(cache_entry.CacheState));
      return L1Cache_State_to_permission(cache_entry.CacheState);
    }

    DPRINTF(RubySlicc, "%s\n", AccessPermission:NotPresent);
    return AccessPermission:NotPresent;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      testAndRead(addr, tbe.DataBlk, pkt);
    } else {
      testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
    }
  }

  int functionalReadPriority() {
    return 10;
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;

    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes +
        testAndWrite(addr, tbe.DataBlk, pkt);
      return num_functional_writes;
    }

    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L1Cache_State_to_permission(state));
    }
  }

  Event mandatory_request_type_to_event(CoherenceClass type) {
    if (type == CoherenceClass:GETS) {
      return Event:Load;
    } else if ((type == CoherenceClass:GETX) ||
               (type == CoherenceClass:UPGRADE)) {
      return Event:Store;
    } else if (type == CoherenceClass:PUTX) {
      return Event:WriteBack;
    } else if (type == CoherenceClass:FLUSH) {
      return Event:Flush;
    } else if (type == CoherenceClass:FLUSH_NP) {
      return Event:Flush_NP;
    } else if (type == CoherenceClass:FLUSH_DATA) {
      return Event:External_Flush_Data_Ack;
    } else if (type == CoherenceClass:SPMCP_FETCH) {
      return Event:SPMCP_fetch;
    } else if (type == CoherenceClass:SPMCP_INSTALL) {
      return Event:SPMCP_install;
    } else if (type == CoherenceClass:SPM_LD) {
      return Event:SPMLD;
    } else if (type == CoherenceClass:SPM_ST) {
      return Event:SPMST;
    } else if (type == CoherenceClass:SPMWB_READ) {
      return Event:SPMWB_read;
    } else if (type == CoherenceClass:SPMWB_STORE) {
      return Event:SPMWB_store;
    } else if (type == CoherenceClass:SPM_RELEASE) {
      return Event:SPM_release;
    } else {
      error("Invalid RequestType");
    }
  }

  int getPendingAcks(TBE tbe) {
    return tbe.pendingAcks;
  }

  bool inL0Cache(State state) {
    if (state == State:S || state == State:E ||
        state == State:M || state == State:SM ||
        state == State:S_IL0 || state == State:E_IL0 ||
        state == State:M_IL0 || state == State:SM_IL0) {
        return true;
    }

    return false;
  }

  out_port(requestNetwork_out, RequestMsg, requestToL2);
  out_port(responseNetwork_out, ResponseMsg, responseToL2);
  out_port(unblockNetwork_out, ResponseMsg, unblockToL2);
  out_port(bufferToL0_out, CoherenceMsg, bufferToL0);
  out_port(spmBufferToL0_out, CoherenceMsg, spmBufferToL0);

  // Response From the L2 Cache to this L1 cache
  in_port(responseNetwork_in, ResponseMsg, responseFromL2, rank = 2) {
    if (responseNetwork_in.isReady(clockEdge())) {
      peek(responseNetwork_in, ResponseMsg) {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceResponseType:L3_SPM_REPLY) {
          if (in_msg.L3Op == 5) {
            trigger(Event:L3WritebackData, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:L3Reply, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPMWB_ACK && isL3SPM(in_msg.DstSPMAddr)) {
          trigger(Event:L3Reply, in_msg.DstSPMAddr, getCacheEntry(in_msg.DstSPMAddr), TBEs[in_msg.DstSPMAddr]);
        } else if (in_msg.Type == CoherenceResponseType:SPM_SILENT_RETRY) {
          trigger(Event:SPM_SilentRetry, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:SPM_MCAST_PENDING) {
          Addr spm_addr := makeLineAddress(in_msg.DstSPMAddr);
          int spm_set := addressToInt(bitSelect(spm_addr, 6, 15));
          int spm_way := addressToInt(bitSelect(spm_addr, 16, 18));
          if (!cache.prepareSPMSlot(spm_set, spm_way)) {
            Addr victim := cache.spmSlotVictim(spm_set, spm_way);
            Entry victim_entry := getCacheEntry(victim);
            TBE victim_tbe := TBEs[victim];
            State victim_state := getState(victim_tbe, victim_entry, victim);
            if (is_valid(victim_tbe) || victim_state == State:S_IL0 ||
                victim_state == State:M_IL0 || victim_state == State:E_IL0 ||
                victim_state == State:MM_IL0) {
              trigger(Event:SPM_McastClaimWait, victim, victim_entry,
                      victim_tbe);
            } else if (is_valid(victim_entry) &&
                       inL0Cache(victim_entry.CacheState)) {
              trigger(Event:L0_Invalidate_Own, victim, victim_entry,
                      victim_tbe);
            } else {
              trigger(Event:L1_Replacement, victim, victim_entry,
                      victim_tbe);
            }
          } else {
            trigger(Event:SPM_McastPending, spm_addr,
                    getCacheEntry(spm_addr), TBEs[spm_addr]);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPM_MCAST_DATA) {
          Addr spm_addr := makeLineAddress(in_msg.DstSPMAddr);
          int spm_set := addressToInt(bitSelect(spm_addr, 6, 15));
          int spm_way := addressToInt(bitSelect(spm_addr, 16, 18));
          if (!cache.prepareSPMSlot(spm_set, spm_way)) {
            Addr victim := cache.spmSlotVictim(spm_set, spm_way);
            Entry victim_entry := getCacheEntry(victim);
            TBE victim_tbe := TBEs[victim];
            State victim_state := getState(victim_tbe, victim_entry, victim);
            if (is_valid(victim_tbe) ||
                victim_state == State:S_IL0 ||
                victim_state == State:M_IL0 ||
                victim_state == State:E_IL0 ||
                victim_state == State:MM_IL0) {
              trigger(Event:SPM_McastClaimWait, victim, victim_entry,
                      victim_tbe);
            } else if (is_valid(victim_entry) &&
                       inL0Cache(victim_entry.CacheState)) {
              trigger(Event:L0_Invalidate_Own, victim, victim_entry,
                      victim_tbe);
            } else {
              trigger(Event:L1_Replacement, victim, victim_entry,
                      victim_tbe);
            }
          } else {
            trigger(Event:SPM_McastData, spm_addr, getCacheEntry(spm_addr),
                    TBEs[spm_addr]);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPM_MCAST_ACK) {
          if (tbe.pendingAcks == 1) {
            trigger(Event:SPM_McastLastAck, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:SPM_McastAck, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPM_MCAST_CLAIM) {
          Addr spm_addr := makeLineAddress(in_msg.DstSPMAddr);
          int spm_set := addressToInt(bitSelect(spm_addr, 6, 15));
          int spm_way := addressToInt(bitSelect(spm_addr, 16, 18));
          if (!cache.prepareSPMSlot(spm_set, spm_way)) {
            Addr victim := cache.spmSlotVictim(spm_set, spm_way);
            Entry victim_entry := getCacheEntry(victim);
            TBE victim_tbe := TBEs[victim];
            State victim_state := getState(victim_tbe, victim_entry, victim);
            if (is_valid(victim_tbe) ||
                victim_state == State:S_IL0 ||
                victim_state == State:M_IL0 ||
                victim_state == State:E_IL0 ||
                victim_state == State:MM_IL0) {
              trigger(Event:SPM_McastClaimWait, victim, victim_entry,
                      victim_tbe);
            } else if (is_valid(victim_entry) &&
                       inL0Cache(victim_entry.CacheState)) {
              trigger(Event:L0_Invalidate_Own, victim, victim_entry,
                      victim_tbe);
            } else {
              trigger(Event:L1_Replacement, victim, victim_entry,
                      victim_tbe);
            }
          } else {
            trigger(Event:SPM_McastClaim, spm_addr,
                    getCacheEntry(spm_addr), TBEs[spm_addr]);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPM_MCAST_CLAIM_ACK) {
          if (tbe.pendingAcks == 1) {
            trigger(Event:SPM_McastClaimLastAck, in_msg.addr,
                    cache_entry, tbe);
          } else {
            trigger(Event:SPM_McastClaimAck, in_msg.addr, cache_entry, tbe);
          }
        } else if(in_msg.Type == CoherenceResponseType:DATA_EXCLUSIVE) {
          if (is_valid(tbe) && isL3SPM(tbe.DstSPMAddr)) {
            trigger(Event:L3SourceData, in_msg.addr, cache_entry, tbe);
          } else if (is_valid(tbe) && tbe.MulticastMask != 0) {
            trigger(Event:SPM_McastSourceData, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Data_Exclusive, in_msg.addr, cache_entry, tbe);
          }
        } else if(in_msg.Type == CoherenceResponseType:DATA) {
          if (is_valid(tbe) && isL3SPM(tbe.DstSPMAddr)) {
            trigger(Event:L3SourceData, in_msg.addr, cache_entry, tbe);
          } else if (is_valid(tbe) && tbe.MulticastMask != 0) {
            trigger(Event:SPM_McastSourceData, in_msg.addr, cache_entry, tbe);
          } else if ((getState(tbe, cache_entry, in_msg.addr) == State:IS ||
               getState(tbe, cache_entry, in_msg.addr) == State:IS_I) &&
              machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {

              trigger(Event:DataS_fromL1, in_msg.addr, cache_entry, tbe);

          } else if ( (getPendingAcks(tbe) - in_msg.AckCount) == 0 ) {
            trigger(Event:Data_all_Acks, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Data, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:ACK) {
          if ( (getPendingAcks(tbe) - in_msg.AckCount) == 0 ) {
            trigger(Event:Ack_all, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:WB_ACK) {
          trigger(Event:WB_Ack, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:FLUSH_ACK) {
          trigger(Event:Flush_Ack, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:PUT_ACK) {
          if (is_valid(tbe) && isL3SPM(tbe.DstSPMAddr)) {
            trigger(Event:L3SourceAck, in_msg.addr, cache_entry, tbe);
          } else if (is_valid(tbe) && tbe.MulticastMask != 0) {
            trigger(Event:SPM_McastPutAck, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Put_Ack, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:SPMWB_ACK) {
          Addr spm_addr := makeLineAddress(in_msg.DstSPMAddr);
          Entry spm_entry := getCacheEntry(spm_addr);
          trigger(Event:SPMWB_Ack, spm_addr, spm_entry, TBEs[spm_addr]);
        } else {
          error("Invalid L1 response type");
        }
      }
    }
  }

  // Response processing above always drains NACKs into existing transaction
  // state. Retry issue can wait for request credits without holding a response.
  in_port(spmSilentRetry_in, Addr, spmSilentRetryTimer) {
    if (spmSilentRetry_in.isReady(clockEdge())) {
      Addr retry_addr := spmSilentRetryTimer.nextAddress();
      trigger(Event:SPM_SilentReissue, retry_addr, getCacheEntry(retry_addr),
              TBEs[retry_addr]);
    }
  }

  in_port(l3Send_in, Addr, l3SendTimer) {
    if (l3Send_in.isReady(clockEdge())) {
      Addr a := l3SendTimer.nextAddress();
      trigger(Event:L3Send, a, getCacheEntry(a), TBEs[a]);
    }
  }

  // Request to this L1 cache from the shared L2
  in_port(requestNetwork_in, RequestMsg, requestFromL2, rank = 1) {
    if(requestNetwork_in.isReady(clockEdge())) {
      peek(requestNetwork_in, RequestMsg) {
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceRequestType:INV) {
            if (is_valid(cache_entry) && inL0Cache(cache_entry.CacheState)) {
                trigger(Event:L0_Invalidate_Else, in_msg.addr,
                        cache_entry, tbe);
            }  else {
                trigger(Event:Inv, in_msg.addr, cache_entry, tbe);
            }
        } else if (in_msg.Type == CoherenceRequestType:GETX ||
                   in_msg.Type == CoherenceRequestType:UPGRADE) {
            if (is_valid(cache_entry) && inL0Cache(cache_entry.CacheState)) {
                trigger(Event:L0_Invalidate_Else, in_msg.addr,
                        cache_entry, tbe);
            } else {
                trigger(Event:Fwd_GETX, in_msg.addr, cache_entry, tbe);
            }
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
            if (is_valid(cache_entry) && inL0Cache(cache_entry.CacheState)) {
                trigger(Event:L0_Invalidate_Else, in_msg.addr,
                        cache_entry, tbe);
            } else {
                trigger(Event:Fwd_GETS, in_msg.addr, cache_entry, tbe);
            }
        } else if (in_msg.Type == CoherenceRequestType:GETS_SILENT) {
            // A silent SPM-copy snapshot. If the freshest data is still down
            // in L0, recall it first (reusing the normal L0 invalidation path);
            // otherwise hand back a snapshot without disturbing coherence.
            State state := getState(tbe, cache_entry, in_msg.addr);
            if (spm_silent_retry && (state == State:I || state == State:IS ||
                state == State:IM || state == State:IS_I || state == State:IX_A)) {
                trigger(Event:Fwd_GETS_SilentRetry, in_msg.addr, cache_entry, tbe);
            } else if (state == State:S || state == State:SM) {
                // VER-11 fix: in S/SM the L0 copy is clean, so this L1's block is
                // current; serve the snapshot without an L0 recall. A stale
                // fire-and-forget forward can reach a former owner that has since
                // downgraded (S) and re-requested ownership (SM); recalling L0 there
                // moved SM -> SM_IL0, where the upgrade's Ack has no transition.
                trigger(Event:Fwd_GETS_Silent, in_msg.addr, cache_entry, tbe);
            } else if (is_valid(cache_entry) && inL0Cache(cache_entry.CacheState)) {
                trigger(Event:L0_Invalidate_Else, in_msg.addr,
                        cache_entry, tbe);
            } else {
                trigger(Event:Fwd_GETS_Silent, in_msg.addr, cache_entry, tbe);
            }
        } else if (in_msg.Type == CoherenceRequestType:FLUSH_DATA) {
            trigger(Event:External_Flush_Data, in_msg.addr, cache_entry, tbe);
        } else {
          error("Invalid forwarded request type");
        }
      }
    }
  }

  // Finite mode returns evictions and recalls here. Process this ordered
  // lane BEFORE local requests: a re-fetch must not pass its older PUTX.
  // SLICC in_port source order sets service priority; rank alone does not.
  // Legacy mode leaves this input empty (replyToL1 aliases bufferFromL0).
  // Keep recall/eviction returns independent of BOTH demand and pure-SPM
  // requests. The latter can stall and must never head-of-line block a recall.
  in_port(returnBufferFromL0_in, CoherenceMsg, returnBufferFromL0, rank = 3) {
    if (returnBufferFromL0_in.isReady(clockEdge())) {
      peek(returnBufferFromL0_in, CoherenceMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if (in_msg.Class == CoherenceClass:INV_DATA) {
          trigger(Event:L0_DataAckEscape, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Class == CoherenceClass:INV_ACK) {
          trigger(Event:L0_AckEscape, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Class == CoherenceClass:PUTX) {
          trigger(Event:WriteBackEscape, in_msg.addr, cache_entry, tbe);
        } else {
          error("Invalid request on independent L0 return buffer");
        }
      }
    }
  }

  in_port(spmBufferFromL0_in, CoherenceMsg, spmBufferFromL0, rank = 3) {
    if (spmBufferFromL0_in.isReady(clockEdge())) {
      peek(spmBufferFromL0_in, CoherenceMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];
        if (isL3SPM(in_msg.DstSPMAddr)) {
          assert(l3_spm_enabled);
          trigger(Event:L3ForwardDirect, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Class == CoherenceClass:SPM_LD) {
          trigger(Event:SPMLD_direct, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Class == CoherenceClass:SPM_ST) {
          trigger(Event:SPMST_direct, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Class == CoherenceClass:SPMWB_READ) {
          trigger(Event:SPMWB_read_direct, in_msg.addr, cache_entry, tbe);
        } else {
          error("Invalid request on direct SPM L0->L1 buffer");
        }
      }
    }
  }

  // Requests to this L1 cache from the L0 cache.
  in_port(messageBufferFromL0_in, CoherenceMsg, bufferFromL0, rank = 0) {
    if (messageBufferFromL0_in.isReady(clockEdge())) {
      peek(messageBufferFromL0_in, CoherenceMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if (isL3SPM(in_msg.DstSPMAddr) && in_msg.Class != CoherenceClass:SPMCP_FETCH) {
            assert(l3_spm_enabled);
            if (in_msg.Class == CoherenceClass:SPMWB_STORE) {
              trigger(Event:L3ForwardWB, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:L3Forward, in_msg.addr, cache_entry, tbe);
            }
        } else if (!isL3SPM(in_msg.DstSPMAddr) && (in_msg.Class == CoherenceClass:SPMCP_FETCH ||
             in_msg.Class == CoherenceClass:SPMCP_INSTALL) &&
            !cache.prepareSPMSlot(in_msg.SPMSet, in_msg.SPMWay)) {
            // Dynamic conversion keeps all ways cache-usable until SPMCP.
            // If the encoded slot is live and no empty unclaimed way can
            // accept migration, evict it through the normal coherence path,
            // leave this SPMCP queued, and retry after replacement completes.
            Addr victim := cache.spmSlotVictim(in_msg.SPMSet, in_msg.SPMWay);
            Entry victim_entry := getCacheEntry(victim);
            TBE victim_tbe := TBEs[victim];
            if (is_valid(victim_entry) && inL0Cache(victim_entry.CacheState)) {
                trigger(Event:L0_Invalidate_Own,
                        victim, victim_entry, victim_tbe);
            } else {
                trigger(Event:L1_Replacement,
                        victim, victim_entry, victim_tbe);
            }
        } else if (in_msg.Class == CoherenceClass:SPMCP_FETCH &&
                   in_msg.MulticastClaim) {
            Addr spm_addr := makeLineAddress(in_msg.DstSPMAddr);
            trigger(Event:SPM_McastClaimLocal, spm_addr,
                    getCacheEntry(spm_addr), TBEs[spm_addr]);
        } else if(in_msg.Class == CoherenceClass:INV_DATA) {
            trigger(Event:L0_DataAck, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:NAK) {
              trigger(Event:L0_DataNak, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:PUTX_COPY) {
              trigger(Event:L0_DataCopy, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:INV_ACK) {
            trigger(Event:L0_Ack, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:FLUSH) {
            trigger(Event:Flush, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:FLUSH_NP) {
            trigger(Event:Flush_NP, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:FLUSH_DATA) {
            trigger(Event:External_Flush_Data_Ack, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:SPMCP_FETCH && in_msg.SPMSnapshot) {
            trigger(Event:SPMCP_snapshot, in_msg.addr, cache_entry, tbe);
        }  else if (in_msg.Class == CoherenceClass:SPMCP_FETCH ||
                    in_msg.Class == CoherenceClass:SPMCP_INSTALL ||
                    in_msg.Class == CoherenceClass:SPM_LD ||
                    in_msg.Class == CoherenceClass:SPM_ST ||
                    in_msg.Class == CoherenceClass:SPMWB_READ ||
                    in_msg.Class == CoherenceClass:SPMWB_STORE ||
                    in_msg.Class == CoherenceClass:SPM_RELEASE) {
            trigger(mandatory_request_type_to_event(in_msg.Class),
                    in_msg.addr, cache_entry, tbe);
        }  else {
            if (is_valid(cache_entry)) {
                trigger(mandatory_request_type_to_event(in_msg.Class),
                        in_msg.addr, cache_entry, tbe);
            } else {
                if (cache.cacheAvail(in_msg.addr)) {
                    // L1 does't have the line, but we have space for it
                    // in the L1 let's see if the L2 has it
                    trigger(mandatory_request_type_to_event(in_msg.Class),
                            in_msg.addr, cache_entry, tbe);
                } else {
                    // No room in the L1, so we need to make room in the L1
                    Addr victim := cache.cacheProbe(in_msg.addr);
                    Entry victim_entry := getCacheEntry(victim);
                    TBE victim_tbe := TBEs[victim];

                    if (is_valid(victim_entry) && inL0Cache(victim_entry.CacheState)) {
                        trigger(Event:L0_Invalidate_Own,
                                victim, victim_entry, victim_tbe);
                    }  else {
                        trigger(Event:L1_Replacement,
                                victim, victim_entry, victim_tbe);
                    }
                }
            }
        }
      }
    }
  }

  // Separate physical storage credits from transient protocol metadata.
  action(micro_miss, "mmm", desc="MICRO private L2 miss") {
    check_allocate(missCredits);
    missCredits.allocate(address);
  }
  action(micro_write, "mmw", desc="Private L2 eviction snapshot") {
    check_allocate(writeCredits);
    writeCredits.allocate(address);
  }
  // ACTIONS
  action(a_issueGETS, "a", desc="Issue GETS") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;
      }
    }
  }

  action(b_issueGETX, "b", desc="Issue GETX") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;
        DPRINTF(RubySlicc, "%s\n", machineID);
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;
      }
    }
  }

  action(c_issueUPGRADE, "c", desc="Issue GETX") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:UPGRADE;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.Prefetch := in_msg.Prefetch;
      }
    }
  }

  action(l3_forward, "l3f", desc="Send shared SPM operation through the finite request network") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := in_msg.DstSPMAddr;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.SrcAddr := in_msg.SrcAddr;
        out_msg.L3ReplyAddr := in_msg.addr;
        out_msg.L3Op := l3Operation(in_msg.Class);
        if (in_msg.Class == CoherenceClass:SPM_ST && bitSelect(in_msg.SrcAddr, 60, 60) == intToAddress(1)) {
          out_msg.L3Op := 7;
        }
        out_msg.Type := CoherenceRequestType:L3_SPM;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(createMachineID(MachineType:L2Cache,
          intToID(addressToInt(bitSelect(in_msg.DstSPMAddr, 20, 22)))));
        out_msg.Len := in_msg.Len;
        if (in_msg.Class == CoherenceClass:SPMWB_STORE) { out_msg.Len := 64; }
        if (in_msg.Class == CoherenceClass:SPMWB_STORE && in_msg.L3Finalize != intToAddress(0)) {
          out_msg.L3Op := 8;
          out_msg.SrcAddr := in_msg.L3Finalize;
          out_msg.Len := 128;
        }
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.SPMMasked := in_msg.SPMMasked;
        out_msg.SPMWriteMask := in_msg.SPMWriteMask;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        if (out_msg.L3Op == 8) { out_msg.MessageSize := MessageSizeType:SPM_FinalizeControl; }
        if (in_msg.Class == CoherenceClass:SPM_ST) {
          out_msg.MessageSize := l3DataSize(in_msg.Len);
          if (out_msg.L3Op == 7) {
            out_msg.MessageSize := MessageSizeType:SPM_Reduce256;
            if (bitSelect(in_msg.SrcAddr, 58, 58) == intToAddress(1)) {
              out_msg.MessageSize := MessageSizeType:SPM_Reduce128;
            }
          }
        }
      }
    }
  }

  action(l3_forwardDirect, "l3fd", desc="Send shared SPM operation through the finite request network") {
    peek(spmBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := in_msg.DstSPMAddr;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.SrcAddr := in_msg.SrcAddr;
        out_msg.L3ReplyAddr := in_msg.addr;
        out_msg.L3Op := l3Operation(in_msg.Class);
        if (in_msg.Class == CoherenceClass:SPM_ST && bitSelect(in_msg.SrcAddr, 60, 60) == intToAddress(1)) {
          out_msg.L3Op := 7;
        }
        out_msg.Type := CoherenceRequestType:L3_SPM;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(createMachineID(MachineType:L2Cache,
          intToID(addressToInt(bitSelect(in_msg.DstSPMAddr, 20, 22)))));
        out_msg.Len := in_msg.Len;
        out_msg.AccessMode := in_msg.AccessMode;
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.SPMMasked := in_msg.SPMMasked;
        out_msg.SPMWriteMask := in_msg.SPMWriteMask;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        if (in_msg.Class == CoherenceClass:SPM_ST) {
          out_msg.MessageSize := l3DataSize(in_msg.Len);
          if (out_msg.L3Op == 7) {
            out_msg.MessageSize := MessageSizeType:SPM_Reduce256;
            if (bitSelect(in_msg.SrcAddr, 58, 58) == intToAddress(1)) {
              out_msg.MessageSize := MessageSizeType:SPM_Reduce128;
            }
          }
        }
      }
    }
  }

  action(l3_schedule, "l3sched", desc="Retain snapshot in existing TBE and free response FIFO") {
    l3SendTimer.set(address, clockEdge() + cyclesToTicks(intToCycles(1)));
  }

  action(l3_sendInstall, "l3send", desc="Send released source snapshot to shared slot") {
    assert(is_valid(tbe));
    assert(l3_spm_enabled);
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      out_msg.addr := tbe.DstSPMAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.L3ReplyAddr := address;
      out_msg.L3Op := 4;
      out_msg.Type := CoherenceRequestType:L3_SPM;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(createMachineID(MachineType:L2Cache,
        intToID(addressToInt(bitSelect(tbe.DstSPMAddr, 20, 22)))));
      out_msg.Len := 64;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.MessageSize := MessageSizeType:Data;
    }
    l3SendTimer.unset(address);
  }

  action(l3_reply, "l3r", desc="Complete shared slot operation only after LLC service") {
    peek(responseNetwork_in, ResponseMsg) {
      enqueue(spmBufferToL0_out, CoherenceMsg, spm_access_response_latency) {
        out_msg.addr := address;
        out_msg.Class := CoherenceClass:SPM_ACK;
        if (in_msg.L3Op == 1) { out_msg.Class := CoherenceClass:SPM_DATA; }
        out_msg.Sender := machineID;
        out_msg.Dest := createMachineID(MachineType:L0Cache, version);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Len := in_msg.Len;
        out_msg.MessageSize := in_msg.MessageSize;
      }
    }
  }

  action(l3_writeback, "l3wb", desc="Forward shared SPM snapshot through normal coherent overwrite protocol") {
      assert(is_valid(tbe));
      assert(tbe.Len <= 64);
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := tbe.SrcAddr;
        out_msg.SrcAddr := tbe.SrcAddr;
        out_msg.DstSPMAddr := tbe.DstSPMAddr;
        out_msg.Type := CoherenceRequestType:SPMWB_REQ;
        out_msg.Len := 64;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := true;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(tbe.SrcAddr, MachineType:L2Cache,
            l2_select_low_bit, l2_select_num_bits, clusterID));
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
      }
      l3SendTimer.unset(address);
  }

  action(spm_issueGETSSilent, "spgs", desc="Issue GETS_SILENT for absent SPM source") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
        out_msg.addr := address;
        out_msg.SrcAddr := in_msg.SrcAddr;
        out_msg.DstSPMAddr := in_msg.DstSPMAddr;
        out_msg.Type := CoherenceRequestType:GETS_SILENT;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, clusterID));
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
      }
    }
  }

  action(spm_issuePUTS, "sps", desc="Release shared coherent source for SPM fetch") {
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      assert(is_valid(tbe));
      out_msg.addr := tbe.SrcAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Len := tbe.Len;
      out_msg.Type := CoherenceRequestType:PUTS;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(mapAddressToRange(tbe.SrcAddr, MachineType:L2Cache,
                        l2_select_low_bit, l2_select_num_bits, clusterID));
      out_msg.MessageSize := MessageSizeType:Writeback_Control;
    }
  }

  action(spm_issuePUTM, "spm", desc="Release modified coherent source for SPM fetch") {
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      assert(is_valid(tbe));
      assert(is_valid(cache_entry));
      out_msg.addr := tbe.SrcAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Len := tbe.Len;
      out_msg.Type := CoherenceRequestType:PUTM;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := true;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(mapAddressToRange(tbe.SrcAddr, MachineType:L2Cache,
                        l2_select_low_bit, l2_select_num_bits, clusterID));
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
    }
  }

  action(spm_issuePUTE, "spe", desc="Release exclusive coherent source for SPM fetch") {
    enqueue(requestNetwork_out, RequestMsg, l1_request_latency) {
      assert(is_valid(tbe));
      out_msg.addr := tbe.SrcAddr;
      out_msg.SrcAddr := tbe.SrcAddr;
      out_msg.DstSPMAddr := tbe.DstSPMAddr;
      out_msg.Len := tbe.Len;
      out_msg.Type := CoherenceRequestType:PUTE;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(mapAddressToRange(tbe.SrcAddr, MachineType:L2Cache,
                        l2_select_low_bit, l2_select_num_bits, clusterID));
      out_msg.MessageSize := MessageSizeType:Writeback_Control;
    }
  }

